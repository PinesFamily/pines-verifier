{
  "format": "pines-verification-schema-v1",
  "schemaId": "pines.chatgpt.plan",
  "version": 3,
  "providerId": "CHATGPT-SUBSCRIPTION",
  "lifecycle": "qualified",
  "request": {
    "origin": "https://chatgpt.com",
    "method": "GET",
    "path": "/backend-api/wham/usage",
    "query": {},
    "body": {
      "kind": "empty"
    }
  },
  "capture": {
    "navigationUrl": "https://chatgpt.com/#settings/Usage",
    "authOrigins": [
      "https://chatgpt.com"
    ],
    "headers": [
      {
        "name": "authorization",
        "required": true,
        "secret": true,
        "validation": "bearer"
      },
      {
        "name": "user-agent",
        "required": true,
        "secret": true,
        "validation": "visible-ascii"
      }
    ],
    "cookies": []
  },
  "replay": {
    "transform": "fixed-request-v1",
    "headers": {
      "accept": "application/json"
    }
  },
  "limits": {
    "maxSentBytes": 8192,
    "maxRecvBytes": 65536,
    "maxHeaderBytes": 8192,
    "maxBodyBytes": 49152,
    "maxJsonDepth": 32,
    "sessionTimeoutMs": 120000,
    "maxRecvRecords": 1024,
    "concurrency": 1
  },
  "response": {
    "status": 200,
    "contentType": "application/json",
    "disclosure": "full-json-body"
  },
  "fields": [
    {
      "id": "plan_type",
      "pointer": "/plan_type",
      "type": "string"
    },
    {
      "id": "user_id",
      "pointer": "/user_id",
      "type": "string"
    }
  ],
  "checks": [
    {
      "op": "in",
      "field": "plan_type",
      "values": [
        "plus",
        "pro",
        "prolite"
      ]
    },
    {
      "op": "custom",
      "field": "user_id",
      "handler": "chatgpt-user-id-v1"
    }
  ],
  "identity": {
    "version": "chatgpt-user-v1",
    "kind": "field",
    "field": "user_id"
  },
  "claims": {
    "enabled": true,
    "domain": "chatgpt.com",
    "templateIds": [
      "CHATGPT-SUBSCRIPTION"
    ]
  }
}
