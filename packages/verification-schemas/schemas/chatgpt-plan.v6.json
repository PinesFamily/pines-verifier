{
  "format": "pines-verification-schema-v1",
  "schemaId": "pines.chatgpt.plan",
  "version": 6,
  "providerId": "CHATGPT-SUBSCRIPTION",
  "lifecycle": "candidate",
  "request": {
    "origin": "https://chatgpt.com",
    "method": "GET",
    "path": "/backend-api/wham/usage",
    "query": {},
    "body": {
      "kind": "empty"
    }
  },
  "capture": {
    "navigationUrl": "https://chatgpt.com/#settings/Usage",
    "authOrigins": [
      "https://chatgpt.com"
    ],
    "headers": [
      {
        "name": "authorization",
        "required": true,
        "secret": true,
        "validation": "bearer"
      },
      {
        "name": "user-agent",
        "required": true,
        "secret": true,
        "validation": "visible-ascii"
      },
      {
        "name": "chatgpt-account-id",
        "required": true,
        "secret": false,
        "validation": "visible-ascii"
      }
    ],
    "cookies": []
  },
  "replay": {
    "transform": "fixed-request-v1",
    "headers": {
      "accept": "application/json"
    }
  },
  "limits": {
    "maxSentBytes": 8192,
    "maxRecvBytes": 65536,
    "maxHeaderBytes": 8192,
    "maxBodyBytes": 32768,
    "maxJsonDepth": 16,
    "sessionTimeoutMs": 120000,
    "maxRecvRecords": 1024,
    "concurrency": 1
  },
  "response": {
    "status": 200,
    "contentType": "application/json",
    "disclosure": "full-json-body"
  },
  "fields": [
    {
      "id": "plan_type",
      "pointer": "/plan_type",
      "type": "string"
    },
    {
      "id": "user_id",
      "pointer": "/user_id",
      "type": "string"
    },
    {
      "id": "account_id",
      "pointer": "/account_id",
      "type": "string"
    },
    {
      "id": "pines_email",
      "pointer": "/email",
      "type": "string"
    }
  ],
  "checks": [
    {
      "op": "in",
      "field": "plan_type",
      "values": [
        "plus",
        "pro",
        "prolite"
      ]
    },
    {
      "op": "custom",
      "field": "user_id",
      "handler": "chatgpt-user-id-v1"
    },
    {
      "op": "custom",
      "field": "account_id",
      "handler": "non-empty-string-v1"
    },
    {
      "op": "custom",
      "field": "pines_email",
      "handler": "non-empty-string-v1"
    }
  ],
  "identity": {
    "version": "chatgpt-user-v1",
    "kind": "field",
    "field": "user_id"
  },
  "claims": {
    "enabled": false,
    "domain": "chatgpt.com",
    "templateIds": [
      "CHATGPT-SUBSCRIPTION"
    ]
  },
  "exchanges": [
    {
      "request": {
        "path": "/backend-api/wham/usage/plan_limit_history",
        "query": {
          "days": "30"
        },
        "headers": []
      },
      "selector": {
        "kind": "chatgpt-plan-limit-history-v1"
      },
      "fields": [
        {
          "id": "pines_tenure_start_at",
          "pointer": "/tenure_start_at",
          "type": "string",
          "transform": "iso-8601-seconds-v1"
        },
        {
          "id": "pines_usage_bucket",
          "pointer": "/usage_bucket",
          "type": "string"
        },
        {
          "id": "chatgpt_history_periods",
          "pointer": "/periods",
          "type": "safe-integer"
        },
        {
          "id": "chatgpt_coverage_complete",
          "pointer": "/coverage_complete",
          "type": "boolean"
        }
      ],
      "checks": [
        {
          "op": "in",
          "field": "pines_usage_bucket",
          "values": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        {
          "op": "lte",
          "field": "chatgpt_history_periods",
          "value": 64
        }
      ],
      "binding": {
        "kind": "request-header",
        "header": "chatgpt-account-id",
        "pointer": "/account_id"
      }
    }
  ]
}
