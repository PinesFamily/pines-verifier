+// Drain the single previously accepted write. A blocked poll_write has not
+// accepted its current buffer, so cancelling it or replacing its buffer is
+// safe.
+fn poll_pending_write(state: &mut AdapterState, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+    let Some(future) = state.pending_write.as_mut() else {
+        return Poll::Ready(Ok(()));
+    };
+    match Pin::new(future).poll(cx) {
+        Poll::Pending => Poll::Pending,
+        Poll::Ready(result) => {
+            state.pending_write = None;
+            match result {
+                Ok(_) => Poll::Ready(Ok(())),
+                Err(_) => {
+                    let message = "JavaScript write failed".to_owned();
+                    state.error = Some(message.clone());
+                    Poll::Ready(Err(std::io::Error::other(message)))
+                }
+            }
+        }
+    }
+}
