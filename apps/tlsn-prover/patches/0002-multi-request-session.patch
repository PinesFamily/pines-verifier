+    /// Sends several HTTP requests to the server via the proxy, in order, over
+    /// one TLS connection.
+    ///
+    /// This method is used for proxy mode only. Each response is read to its
+    /// end before the next request is written, so the transcript is
+    /// `request 1, response 1, request 2, response 2, ...` of one TLS
+    /// session. The caller's last request carries `connection: close`. Every
+    /// response is returned, and the prover is left in the same state as
+    /// after [`Self::send_request_proxy`].
+    ///
+    /// # Arguments
+    ///
+    /// * `requests` - The HTTP requests to send, at least one.
+    pub async fn send_requests_proxy(
+        &mut self,
+        requests: Vec<HttpRequest>,
+    ) -> Result<Vec<HttpResponse>> {
+        if requests.is_empty() {
+            return Err(SdkError::config("at least one request is required"));
+        }
+
+        // Every request is built before the connection opens, so a request
+        // that cannot be built sends nothing.
+        let requests = requests
+            .into_iter()
+            .map(canonical_session_request)
+            .collect::<Result<Vec<_>>>()?;
+
+        let State::CommitAcceptedProxy { prover, handle } = self.state.take() else {
+            return Err(SdkError::invalid_state(
+                "prover is not in commit accepted proxy state",
+            ));
+        };
+
+        let tls_config = self.build_tls_config()?;
+
+        info!("connecting to proxy");
+
+        let (tls_conn, prover) = prover
+            .connect(tls_config)
+            .map_err(|e| SdkError::protocol(e.to_string()))?;
+
+        info!("sending {} requests", requests.len());
+
+        let (responses, prover) = match futures::try_join!(
+            async {
+                let result = send_requests(tls_conn, requests).await;
+                info!(
+                    "send_requests completed with result: {:?}",
+                    result.as_ref().map(|_| "Ok").map_err(|e| e.to_string())
+                );
+                result
+            },
+            async {
+                let result = prover.await;
+                info!(
+                    "prover completed with result: {:?}",
+                    result.as_ref().map(|_| "Ok").map_err(|e| e.to_string())
+                );
+                result.map_err(|e| SdkError::protocol(e.to_string()))
+            }
+        ) {
+            Ok(result) => {
+                info!("try_join succeeded");
+                result
+            }
+            Err(e) => {
+                error!("try_join failed: {}", e);
+                return Err(e);
+            }
+        };
+
+        info!("responses received, prover transitioning to Committed state");
+
+        self.state = State::Committed { prover, handle };
+
+        Ok(responses)
+    }
