+// HashMap iteration is independently randomized for each HttpRequest. Build and
+// validate with the existing conversion, then insert normalized header names in
+// a fixed order so every request in a session has consistent wire ordering.
+fn canonical_session_request(request: HttpRequest) -> Result<hyper::Request<Full<Bytes>>> {
+    let mut request = hyper::Request::<Full<Bytes>>::try_from(request)?;
+    let mut headers = request
+        .headers()
+        .iter()
+        .map(|(name, value)| (name.clone(), value.clone()))
+        .collect::<Vec<_>>();
+    headers.sort_by(|(left, _), (right, _)| left.as_str().cmp(right.as_str()));
+    request.headers_mut().clear();
+    for (name, value) in headers {
+        request.headers_mut().append(name, value);
+    }
+    Ok(request)
+}
+
+/// Sends the requests in order on one HTTP/1.1 connection, without
+/// pipelining: each response body is read to its end before the next request
+/// is written.
+async fn send_requests(
+    conn: TlsConnection,
+    requests: Vec<hyper::Request<Full<Bytes>>>,
+) -> Result<Vec<HttpResponse>> {
+    let conn = HyperIo::new(conn);
+
+    let (mut request_sender, conn) = hyper::client::conn::http1::handshake(conn).await?;
+
+    crate::spawn::spawn(async move {
+        if let Err(e) = conn.await {
+            tracing::error!("HTTP connection error: {e}");
+        }
+    });
+
+    let mut responses = Vec::with_capacity(requests.len());
+    for request in requests {
+        // Resolves once the previous exchange has completed and the
+        // connection is still open; fails if the connection has closed.
+        request_sender.ready().await?;
+
+        let response = request_sender.send_request(request).await?;
+
+        let (response, body) = response.into_parts();
+
+        let body = body
+            .collect()
+            .await
+            .map_err(|e| SdkError::http(e.to_string()))?;
+        let body_bytes = body.to_bytes().to_vec();
+
+        let headers = response
+            .headers
+            .into_iter()
+            .map(|(k, v)| {
+                (
+                    k.map(|k| k.to_string()).unwrap_or_default(),
+                    v.as_bytes().to_vec(),
+                )
+            })
+            .collect();
+
+        responses.push(HttpResponse {
+            status: response.status.as_u16(),
+            headers,
+            body: if body_bytes.is_empty() {
+                None
+            } else {
+                Some(body_bytes)
+            },
+        });
+    }
+
+    Ok(responses)
+}
