# Build from a minimal context made by prepare-image.py. These public base-index
# digests were obtained from Docker Hub on 2026-10-03. Building this image does
# not qualify it: two clean EIFs, fresh quotes and all hardware gates are required.
FROM rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS native
WORKDIR /source
COPY apps/tlsn-verifier/ apps/tlsn-verifier/
ENV CARGO_INCREMENTAL=0
RUN cargo build --locked --release --manifest-path apps/tlsn-verifier/Cargo.toml --example tee-hardware -j 2
RUN rustup target add x86_64-unknown-linux-musl
COPY tools/tee-native/hardware/runtime/ tools/tee-native/hardware/runtime/
RUN cargo build --locked --release --target x86_64-unknown-linux-musl --manifest-path tools/tee-native/hardware/runtime/Cargo.toml -j 2

FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
ARG SOURCE_DATE_EPOCH=0
WORKDIR /app
COPY --from=native /source/apps/tlsn-verifier/target/release/examples/tee-hardware /app/bin/tee-hardware
COPY --from=native /source/tools/tee-native/hardware/runtime/target/x86_64-unknown-linux-musl/release/pines-nitro-runtime /app/bin/pines-nitro-runtime
COPY --from=native /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libssl.so.3
COPY --from=native /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3
COPY packages/verification-schemas/ packages/verification-schemas/
COPY tools/tee-native/ tools/tee-native/
RUN cd tools/tee-native && NODE_DISABLE_COMPILE_CACHE=1 npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && rm -rf /root/.npm /tmp/node-compile-cache \
    && find /app /root /tmp -xdev -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} + \
    && touch -h -d "@${SOURCE_DATE_EPOCH}" /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu
# The enclave boots without external time/network. Root sets its kernel clock
# from the NSM device before starting any application or TLSN listener.
USER root
# Nitro's init uses CMD/ENTRYPOINT and ENV, but does not apply Docker WORKDIR.
ENTRYPOINT []
CMD ["/usr/local/bin/node", "/app/tools/tee-native/hardware/entrypoint.mjs"]
